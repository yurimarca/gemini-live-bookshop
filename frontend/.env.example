# Copy to frontend/.env.local for development, or frontend/.env.production.local for a build.
# Both are git-ignored. Never commit real values: this repository is public.

# Leave every VITE_FIREBASE_* empty to use dev tokens (the gateway must run with AUTH_MODE=dev).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: reCAPTCHA Enterprise site key for App Check. Empty turns App Check off.
VITE_RECAPTCHA_SITE_KEY=

# Production only. The audio WebSocket goes straight to Cloud Run (Hosting has a 60 s timeout):
#   VITE_GATEWAY_WS_URL=wss://bookshop-gateway-xxxxx.a.run.app/ws/live
# Leave empty in development: Vite proxies /ws and /api to the local gateway.
VITE_GATEWAY_WS_URL=

# Optional. Set only if Firebase Hosting does not forward the Authorization header on /api rewrites:
#   VITE_API_BASE_URL=https://bookshop-gateway-xxxxx.a.run.app
VITE_API_BASE_URL=
