config {
  type: "table",
  schema: "ol_marts",
  description: "The published catalog, one row per book, in the CatalogBook schema. Exported to NDJSON and written to Firestore by `olpipe publish`."
}

WITH ranked AS (
  SELECT
    d.*,
    d.work_key IN (SELECT work_key FROM ${ref("seed_overrides")} WHERE action = 'include') AS forced,
    ROW_NUMBER() OVER (
      PARTITION BY (d.cover_id IS NOT NULL AND d.description IS NOT NULL) ORDER BY d.score DESC, d.work_key
    ) AS famous_rank,
    ROW_NUMBER() OVER (
      PARTITION BY (d.cover_id IS NOT NULL AND d.is_brazilian_author) ORDER BY d.score DESC, d.work_key
    ) AS brazilian_rank,
    ROW_NUMBER() OVER (
      PARTITION BY (d.cover_id IS NOT NULL AND d.has_portuguese_edition AND d.title_pt IS NOT NULL)
      ORDER BY d.score DESC, d.work_key
    ) AS portuguese_rank
  FROM ${ref("int_dedup")} AS d
),
flagged AS (
  SELECT
    *,
    (cover_id IS NOT NULL AND description IS NOT NULL
      AND famous_rank <= ${cfg.num("segments_famous_size")}) AS in_famous,
    (cover_id IS NOT NULL AND is_brazilian_author
      AND brazilian_rank <= ${cfg.num("segments_brazilian_author_size")}) AS in_brazilian,
    -- Portuguese here means a Portuguese edition of a work that is not already in on fame alone.
    (cover_id IS NOT NULL AND has_portuguese_edition AND title_pt IS NOT NULL
      AND portuguese_rank <= ${cfg.num("segments_portuguese_language_size")}) AS in_portuguese
  FROM ranked
),
selected AS (
  SELECT * FROM flagged
  WHERE in_famous OR in_brazilian OR in_portuguese OR (forced AND cover_id IS NOT NULL)
),

-- Genre: the scored rule table in seeds/category_rules.csv, applied to every subject of the selected works.
-- Same algorithm as src/olpipe/categories.py (tests/test_categories.py runs it on the gold set).
-- Only the selected books are scored, so the regular expressions run over a few thousand rows.
rules AS (SELECT * FROM ${ref("seed_category_rules")}),
subject_rows AS (
  SELECT w.work_key, o, LOWER(TRIM(x)) AS subject
  FROM ${ref("stg_works")} AS w, UNNEST(w.subjects) AS x WITH OFFSET o
  WHERE w.work_key IN (SELECT work_key FROM selected) AND TRIM(x) != ''
),
ignored AS (
  SELECT DISTINCT k.work_key, k.o
  FROM subject_rows AS k JOIN rules AS r ON r.category = '_ignore' AND REGEXP_CONTAINS(k.subject, r.pattern)
),
kept AS (
  SELECT k.* FROM subject_rows AS k LEFT JOIN ignored AS i USING (work_key, o) WHERE i.o IS NULL
),
signals AS (
  SELECT
    k.work_key,
    LOGICAL_OR(r.category = '_fiction') AND NOT LOGICAL_OR(r.category = '_nonfiction') AS is_fiction,
    LOGICAL_OR(r.category = '_nonfiction') AS nonfiction_hit
  FROM kept AS k JOIN rules AS r ON r.category IN ('_fiction', '_nonfiction') AND REGEXP_CONTAINS(k.subject, r.pattern)
  GROUP BY k.work_key
),
-- Each subject adds, per genre, the highest weight among that genre's matching rules.
subject_genre AS (
  SELECT k.work_key, k.o, r.category, MAX(r.weight) AS weight, MIN(r.rule_id) AS first_rule
  FROM kept AS k
  LEFT JOIN signals AS g USING (work_key)
  JOIN rules AS r
    ON NOT STARTS_WITH(r.category, '_')
   AND (r.applies = 'any' OR NOT IFNULL(g.is_fiction, FALSE))
   AND REGEXP_CONTAINS(k.subject, r.pattern)
  GROUP BY k.work_key, k.o, r.category
),
genre AS (
  SELECT work_key, ARRAY_AGG(category ORDER BY score DESC, first_rule LIMIT 1)[OFFSET(0)] AS category
  FROM (
    SELECT work_key, category, SUM(weight) AS score, MIN(first_rule) AS first_rule
    FROM subject_genre GROUP BY work_key, category
  )
  GROUP BY work_key
),
-- A Brazilian author's usual genre, for their works with no genre score (many have no subjects at all).
author_default AS (
  SELECT name AS brazilian_person, ANY_VALUE(NULLIF(TRIM(default_genre), '')) AS default_genre
  FROM ${ref("seed_brazilian_authors")} GROUP BY name
),
collection_hits AS (
  SELECT
    work_key,
    LOGICAL_OR(REGEXP_CONTAINS(subject, ${cfg.raw(cfg.re.brazilianSubject)})) AS brazilian_subject,
    LOGICAL_OR(REGEXP_CONTAINS(subject, ${cfg.raw(cfg.re.classicsSubject)})) AS classics_subject
  FROM subject_rows GROUP BY work_key
)
SELECT
  s.work_id AS id,
  s.work_key,
  s.title,
  s.subtitle,
  s.title_pt,
  s.authors,
  ARRAY(SELECT name FROM UNNEST(s.authors)) AS author_names,
  s.description,
  s.description_source,
  s.subjects,
  -- No genre score: the Brazilian author's default genre, else Nonfiction when a subject says so,
  -- otherwise Fiction (most of the catalog).
  COALESCE(g.category, ad.default_genre, IF(IFNULL(sg.nonfiction_hit, FALSE), 'Nonfiction', 'Fiction')) AS category,
  s.cover_id,
  s.first_publish_year,
  s.languages,
  -- Only claim a language that an edition shows. Without editions (r2) this is NULL for every book.
  CASE WHEN s.has_portuguese_edition AND (s.in_portuguese OR s.in_brazilian) THEN 'por'
       ELSE s.edition.language END AS primary_language,
  ARRAY_CONCAT(
    IF(s.in_famous, ['famous'], []),
    IF(s.in_brazilian, ['brazilian_author'], []),
    IF(s.in_portuguese, ['portuguese_language'], [])
  ) AS segments,
  ARRAY_CONCAT(
    IF(s.is_brazilian_author OR IFNULL(c.brazilian_subject, FALSE), ['brazilian'], []),
    IF(IFNULL(c.classics_subject, FALSE), ['classics'], [])
  ) AS collections,
  s.edition,
  ${cfg.priceCents("s.work_key")} AS price_cents,
  TRUE AS price_is_fictional,
  IF(s.rating_count > 0, STRUCT(ROUND(s.rating_average, 2) AS average, s.rating_count AS count), NULL) AS rating,
  STRUCT(
    ROUND(s.score, 4) AS score,
    ROW_NUMBER() OVER (ORDER BY s.score DESC, s.work_key) AS rank,
    s.want_to_read, s.currently_reading, s.already_read
  ) AS popularity,
  CONCAT('https://openlibrary.org', s.work_key) AS book_url,
  '${cfg.datasetVersion}' AS dataset_version,
  STRUCT('${cfg.dumpDate}' AS dump_date, '${cfg.revision}' AS revision, s.last_modified, 'CC0' AS license) AS source
FROM selected AS s
LEFT JOIN genre AS g USING (work_key)
LEFT JOIN signals AS sg USING (work_key)
LEFT JOIN collection_hits AS c USING (work_key)
LEFT JOIN author_default AS ad USING (brazilian_person)
