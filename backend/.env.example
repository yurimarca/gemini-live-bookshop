# Copy to backend/.env (git-ignored). Placeholders only; never commit real values.

# --- Local development without any cloud resource ---
CATALOG_SOURCE=fixture            # fixture | cloud
STATE_BACKEND=memory              # memory | firestore
AUTH_MODE=dev                     # dev | firebase   (dev is refused on Cloud Run)
TASKS_BACKEND=local               # local | cloud_tasks
SPECIALISTS_BACKEND=local         # local | agent_runtime
SPECIALISTS_LLM=off               # on | off   (off uses the deterministic ranker)
ALLOWED_ORIGINS=http://localhost:5173

# --- Gemini Live through Vertex AI (needed to talk; uses your ADC) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
LIVE_MODEL=gemini-3.8-live
SPECIALIST_MODEL=gemini-3.5-flash
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false

# --- Cloud mode (set on Cloud Run by the deploy command) ---
# CATALOG_BUCKET=your-project-id-catalog
# FIRESTORE_DATABASE=(default)
# TASKS_QUEUE=cart-expiry
# TASKS_SERVICE_ACCOUNT=bookshop-runtime@your-project-id.iam.gserviceaccount.com
# PUBLIC_BASE_URL=https://bookshop-gateway-xxxxx.a.run.app
# APP_CHECK_REQUIRED=false
# SPECIALISTS_AGENT_RESOURCE=projects/your-project-number/locations/us-central1/reasoningEngines/0000000000

# --- Limits ---
SESSION_MAX_SECONDS=300
SESSION_WARN_SECONDS=270
SESSIONS_PER_USER_PER_DAY=5
SESSIONS_GLOBAL_PER_DAY=100
MAX_CONCURRENT_SESSIONS=10
CART_HOLD_SECONDS=600              # set 60 to hear the spoken expiry notice quickly
ANNOUNCE_CART_EXPIRY=true          # the agent says so when the cart hold runs out
AUTO_RESEARCH_AFTER_NOTES=3        # researcher runs by itself after this many taste notes; 0 = off
